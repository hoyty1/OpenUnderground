{
  "name": "deceit-map-editor",
  "version": "1.1.0",
  "description": "Ultima IV Deceit dungeon map editor for OpenUnderground (offline vanilla-JS build with tool palette)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "ultima",
    "underworld",
    "map",
    "editor"
  ],
  "author": "hoyty1",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {},
  "build": {
    "appId": "com.openunderground.deceitmapeditor",
    "productName": "Deceit Map Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}